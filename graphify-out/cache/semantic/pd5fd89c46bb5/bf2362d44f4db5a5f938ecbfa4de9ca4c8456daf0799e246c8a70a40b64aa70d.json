{"nodes": [{"id": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_spec", "label": "Skin Cancer RAG-Enhanced Chatbot Design Spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "Adds a RAG layer plus a Flask-to-FastAPI refactor because the original chatbot hit the OpenAI API with no domain grounding, which is a hallucination risk in healthcare."}, {"id": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_three_layer_disclaimer", "label": "Three-Layer Mandatory Medical Disclaimer", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a75.1", "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "Layer 1 (system prompt) is vulnerable to prompt injection, so layer 2 (deterministic post-generation regex force-append) is added as the bypass-proof guarantee, and layer 3 (persistent UI footer) is independent of the LLM entirely. Defense in depth because a missing disclaimer is a compliance failure, not a UX bug."}, {"id": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_evidence_filter", "label": "Evidence Filter (Cosine Similarity Threshold)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a74.2 step 5, \u00a710", "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "Retrieve top-10 then drop chunks below a conservative 0.7 cosine threshold, overshooting before filtering. Motivated directly by the 'Rethinking RAG for Medicine' finding that raw RAG can degrade medical answer quality \u2014 a conservative gate is preferred to more context."}, {"id": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_lcel_chain", "label": "LCEL RAG Chain (retriever | prompt | llm)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a74.1, \u00a77.1", "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "LCEL rather than LangGraph in v1 for simplicity; the agentic grader loop is deferred to Phase 4 as an explicit YAGNI cut with a clear evolution path. Chain is stateless with injected dependencies and no globals so it can be unit-tested without a server."}, {"id": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_single_multilingual_prompt", "label": "Single Multilingual Prompt Template", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a74.3", "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "One template serves both ID and EN because modern LLMs are sufficiently multilingual; maintaining two near-identical templates costs maintenance without quality benefit. Only the disclaimer needs hardcoded per-language versions."}, {"id": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_llm_provider_abstraction", "label": "LLMProvider Protocol + Factory", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a77.1", "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "Protocol plus env-var factory so swapping OpenAI for Ollama/vLLM is a config change, never a caller change; success metric is that the swap is verified by integration test with only an env var edit."}, {"id": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_vector_store_abstraction", "label": "VectorStoreProvider Protocol + Factory", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a77.1", "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "ChromaDB chosen as default because it is local, free, and privacy-friendly for healthcare data; Pinecone stubbed behind the same Protocol as a future swap path rather than deployed."}, {"id": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_semantic_chunking_ingestion", "label": "Semantic Chunking Ingestion Pipeline", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a73.2", "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "Percentile-breakpoint semantic chunking at 500-800 tokens with 100-token overlap, embedded in batches of 100 and upserted with SHA256 hash-based chunk IDs so re-running ingestion is idempotent."}, {"id": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_knowledge_base_tiers", "label": "Two-Tier Knowledge Base (Guidelines + PubMed)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a73.1", "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "Tier 1 is patient-education guidelines (AAD, MedlinePlus, DermNet NZ) for trust and plain language; Tier 2 is curated PubMed abstracts for deeper questions. Unified single index rather than two indexes, deferring intent routing to a later phase. Licensing drove selection: AAD/MedlinePlus free for education, DermNet CC BY-NC-ND acceptable for academic use."}, {"id": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_dangerous_query_classifier", "label": "Pre-LLM Dangerous Query Classifier", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a75.2", "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "Four categories (safe_medical, safe_general, unsafe_dosage, off_topic); keyword/regex heuristics handle obvious cases cheaply and a gpt-4o-mini zero-shot prompt is reserved for ambiguous ones to keep per-call cost near $0.0001."}, {"id": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_prompt_injection_defense", "label": "Prompt Injection Defense", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a75.3", "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "System-prompt rule 7 plus input pattern flagging plus 'output is always text, never executable'. Explicitly acknowledged as insufficient alone \u2014 the deterministic disclaimer force-append is the actual bypass-proof control."}, {"id": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_pii_query_hashing", "label": "SHA256 Query Hashing for Logs", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a75.5, \u00a76", "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "Raw query text is never persisted; only a SHA256 hash plus non-identifying counters go to logs/rag_usage.log. Success criterion is 'zero raw PII in logs', verified by grepping log files."}, {"id": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_inline_citation_markers", "label": "Inline [n] Citation Markers", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a74.6, \u00a711", "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "Markers are inline in the streamed text, but the full source list can only be rendered after the stream completes since only then is it known which numbers the answer actually used. Practice borrowed from MMed-RAG and MedRGB."}, {"id": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_bounded_session_memory", "label": "Bounded 6-Turn Session Memory", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a74.5", "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "Last 6 turns (3 exchanges) per session; the detection result is injected once at conversation start rather than repeated every turn to save tokens. Session loss on restart is explicitly accepted as low-impact \u2014 start fresh with no error surfaced."}, {"id": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_sse_streaming", "label": "SSE Token Streaming via StreamingResponse", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a72.2, \u00a74.6", "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "Native FastAPI support and better perceived latency than waiting for a full response; target is first token under 2s even with p95 total under 8s."}, {"id": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_eval_gold_set", "label": "30-Question Bilingual Eval Gold Set", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a78.3, \u00a78.4", "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "15 EN + 15 ID questions each annotated with expected source tier and required content. Metrics: recall@5 > 70%, citation accuracy > 90%, disclaimer presence 100%, hallucination < 10%, p95 < 8s, and bilingual parity between the ID and EN subsets."}, {"id": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_module_boundary_rule", "label": "Framework-Agnostic RAG Module Boundary", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a72.3", "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "RAG logic has no FastAPI imports; routes are thin wrappers and schemas are the only framework-specific layer. Buys three things: unit-testing the chain without a server, swapping web frameworks without touching retrieval, and reusing the chain from CLI/notebooks."}, {"id": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_cross_lingual_embedder", "label": "Cross-Lingual Embedder (text-embedding-3-small)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a72.2, \u00a710", "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "The KB is English-only but users query in Indonesian, so a cross-lingual embedder is the mitigation for the ID-query/EN-corpus mismatch risk; verification test requires 'kanker kulit' to retrieve 'skin cancer' docs. BGE-m3 is the swap target if moving to a local LLM."}, {"id": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_mirage_medrag", "label": "MIRAGE / MedRAG Benchmark (2402.13178)", "file_type": "paper", "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a711", "source_url": "https://hf.co/papers/2402.13178", "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_mmed_rag", "label": "MMed-RAG (2410.13085)", "file_type": "paper", "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a711", "source_url": "https://hf.co/papers/2410.13085", "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_i_medrag", "label": "i-MedRAG (2408.00727)", "file_type": "paper", "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a711", "source_url": "https://hf.co/papers/2408.00727", "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_rethinking_rag_medicine", "label": "Rethinking RAG for Medicine (2511.06738)", "file_type": "paper", "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a710, \u00a711", "source_url": "https://hf.co/papers/2511.06738", "captured_at": null, "author": null, "contributor": null, "rationale": "Cited as the warning that raw RAG can degrade medical performance; it is the stated motivation for both the evidence filter and the citation discipline."}, {"id": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_briefcontext", "label": "BriefContext (2412.15271)", "file_type": "paper", "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a711", "source_url": "https://hf.co/papers/2412.15271", "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_spec", "target": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_three_layer_disclaimer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a75.1", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_spec", "target": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_evidence_filter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a74.2", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_spec", "target": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_lcel_chain", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a74.1", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_lcel_chain", "target": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_evidence_filter", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a74.1", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_lcel_chain", "target": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_single_multilingual_prompt", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a74.1", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_lcel_chain", "target": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_llm_provider_abstraction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a77.1", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_evidence_filter", "target": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_vector_store_abstraction", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a74.2", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_evidence_filter", "target": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_rethinking_rag_medicine", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a710, \u00a711", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_three_layer_disclaimer", "target": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_rethinking_rag_medicine", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a711", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_inline_citation_markers", "target": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_mmed_rag", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a711", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_knowledge_base_tiers", "target": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_mmed_rag", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a711", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_cross_lingual_embedder", "target": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_mirage_medrag", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a711", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_spec", "target": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_i_medrag", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a711", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_spec", "target": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_briefcontext", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a711", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_cross_lingual_embedder", "target": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_knowledge_base_tiers", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a710", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_semantic_chunking_ingestion", "target": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_knowledge_base_tiers", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a73.2", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_semantic_chunking_ingestion", "target": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_vector_store_abstraction", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a73.2", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_prompt_injection_defense", "target": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_three_layer_disclaimer", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a75.1, \u00a75.3", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_dangerous_query_classifier", "target": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_lcel_chain", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a75.2", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_sse_streaming", "target": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_inline_citation_markers", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a74.6", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_eval_gold_set", "target": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_evidence_filter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md", "source_location": "\u00a78.4", "weight": 1.0}], "hyperedges": [{"id": "three_layer_disclaimer_enforcement", "label": "Three-Layer Mandatory Disclaimer Enforcement", "nodes": ["docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_three_layer_disclaimer", "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_prompt_injection_defense", "templates_chat_disclaimer_banner", "templates_partials_disclaimer_bar_component", "review_f7_blocked_path_skips_compliance", "tests_eval_report_metrics_table"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/specs/2026-06-20-skin-cancer-rag-design.md"}]}