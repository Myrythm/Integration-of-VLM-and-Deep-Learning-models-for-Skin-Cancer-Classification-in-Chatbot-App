{"nodes": [{"id": "docs_superpowers_specs_2026_07_04_pubmed_kb_expansion_design_spec", "label": "PubMed Knowledge Base Expansion Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-04-pubmed-kb-expansion-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_04_pubmed_kb_expansion_design_empty_kb_root_cause", "label": "Empty Knowledge Base Root Cause", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-04-pubmed-kb-expansion-design.md", "source_location": "Problem", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chroma held only ~6 chunks from one sample markdown per source and fetch_pubmed.py had never been run. This explained the production symptom where /api/chat returned 200 with num_chunks_retrieved=0 and still produced an ungrounded, uncited answer \u2014 a silent failure, not an error."}, {"id": "docs_superpowers_specs_2026_07_04_pubmed_kb_expansion_design_incremental_ingest_no_rebuild", "label": "Incremental Ingest Without --rebuild", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-04-pubmed-kb-expansion-design.md", "source_location": "Approach", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "--rebuild wipes the whole collection; since this task only adds PubMed content, rebuilding is unnecessary churn that risks damaging the already-working aad/dermnet/medlineplus chunks."}, {"id": "docs_superpowers_specs_2026_07_04_pubmed_kb_expansion_design_similarity_threshold_discrepancy", "label": "RAG_SIMILARITY_THRESHOLD Config Discrepancy", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-04-pubmed-kb-expansion-design.md", "source_location": "Approach step 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ".env.example suggests 0.7 while