d-folder-restructure-design.md", "source_location": "\u00a73.5", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_ui_and_folder_restructure_design_dark_mode_class_strategy", "target": "templates_partials_navbar_theme_toggle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-ui-and-folder-restructure-design.md", "source_location": "\u00a73.5", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_ui_and_folder_restructure_design_spec", "target": "docs_superpowers_specs_2026_06_20_ui_and_folder_restructure_design_indonesian_ui_chrome", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-ui-and-folder-restructure-design.md", "source_location": "\u00a71.2", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_ui_and_folder_restructure_design_indonesian_ui_chrome", "target": "docs_superpowers_specs_2026_07_05_vlm_image_validation_and_label_fix_design_bilingual_rejection_message", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/specs/2026-06-20-ui-and-folder-restructure-design.md", "source_location": "\u00a71.2", "weight": 1.0}], "hyperedges": []}