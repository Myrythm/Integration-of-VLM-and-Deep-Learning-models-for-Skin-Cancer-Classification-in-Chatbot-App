{"nodes": [{"id": "docs_superpowers_specs_2026_06_20_ui_and_folder_restructure_design_spec", "label": "UI + Folder Restructure Design Spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-06-20-ui-and-folder-restructure-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "The v2 RAG backend worked over API only with no UI, and `utils/` was judged too generic a name for business logic. Adds a 3-page UI and renames the package in one pass."}, {"id": "docs_superpowers_specs_2026_06_20_ui_and_folder_restructure_design_utils_to_services_refactor", "label": "utils/ to services/ Refactor", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-20-ui-and-folder-restructure-design.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "Executed with `git mv` to preserve history, pycache removed first so the moves don't fail, ~30 import sites updated, and verified by requiring `grep -r \"from utils\" .` to return zero and all 64 pre-existing tests to still pass."}, {"id": "docs_superpowers_specs_2026_06_20_ui_and_folder_restructure_design_anti_ai_slop_principia", "label": "Anti-AI-Slop Design Principia", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-20-ui-and-folder-restructure-design.md", "source_location": "\u00a73.1, \u00a73.2", "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "Explicit ban list \u2014 gradient hero, 'AI-powered' copy, 3-column icon grid, generic 'Get Started' CTA, glassmorphism, generic chat bubbles \u2014 because each is trendy/characterless and dates fast. Replaced with a flat document-like medical-report aesthetic, definition lists, domain-specific CTAs ('Upload Foto Lesi', 'Klasifikasikan'), and Indonesian healthcare vocabulary (Sp.KK, faktor risiko). Notably, the shipped home.html contradicts several of these."}, {"id": "docs_superpowers_specs_2026_06_20_ui_and_folder_restructure_design_clinical_color_palette", "label": "Clinical Light/Dark Color Palette", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-20-ui-and-folder-restructure-design.md", "source_location": "\u00a73.3", "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "Medical teal + warm neutral + amber + dark slate, no gradients. Dark mode uses slate-900 rather than pure black to keep clinical softness, and teal/amber are brightened in dark to hold WCAG AA contrast."}, {"id": "docs_superpowers_specs_2026_06_20_ui_and_folder_restructure_design_dark_mode_class_strategy", "label": "Tailwind darkMode:'class' Toggle Strategy", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-20-ui-and-folder-restructure-design.md", "source_location": "\u00a73.5", "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "Class toggle on <html> with localStorage persistence, falling back to prefers-color-scheme on first visit only. Tailwind config must be declared before the CDN script loads or darkMode:'class' is ignored."}, {"id": "docs_superpowers_specs_2026_06_20_ui_and_folder_restructure_design_fetch_readablestream_sse", "label": "fetch() + ReadableStream SSE Parsing", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-20-ui-and-folder-restructure-design.md", "source_location": "\u00a74.4", "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "Standard EventSource only supports GET, but /api/chat is a POST carrying session_id/message/detection, so the client must parse the SSE frame format manually off a ReadableStream reader."}, {"id": "docs_superpowers_specs_2026_06_20_ui_and_folder_restructure_design_three_page_ui", "label": "Three-Page MVP UI (Home, Upload, Chat)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-20-ui-and-folder-restructure-design.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "Deliberately scoped to three pages: no article pages, no FAQ, no bilingual UI toggle, no browser automation tests. UI chrome is Indonesian-only while chatbot responses stay bilingual."}, {"id": "docs_superpowers_specs_2026_06_20_ui_and_folder_restructure_design_tailwind_cdn", "label": "Tailwind via CDN (No Build Step)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-20-ui-and-folder-restructure-design.md", "source_location": "\u00a72.1, \u00a77", "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "No npm and no build step keeps the Python-only toolchain intact; the ~3MB CDN payload is explicitly accepted as fine for a demo/academic deployment. Vanilla JS only \u2014 no Alpine.js or HTMX."}, {"id": "docs_superpowers_specs_2026_06_20_ui_and_folder_restructure_design_indonesian_ui_chrome", "label": "Indonesian-Only UI Chrome", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-20-ui-and-folder-restructure-design.md", "source_location": "\u00a71.2, \u00a71.3", "source_url": null, "captured_at": null, "author": "Brainstorming session", "contributor": null, "rationale": "Navbar, buttons, and labels are Bahasa Indonesia only \u2014 a bilingual UI toggle is an explicit non-goal \u2014 while chatbot responses stay bilingual. Splitting the two lets the interface commit to the Indonesian patient context (Sp.KK, faktor risiko) without duplicating chrome strings."}], "edges": [{"source": "docs_superpowers_specs_2026_06_20_ui_and_folder_restructure_design_spec", "target": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_spec", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-ui-and-folder-restructure-design.md", "source_location": "\u00a71.1", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_ui_and_folder_restructure_design_utils_to_services_refactor", "target": "docs_superpowers_specs_2026_06_20_skin_cancer_rag_design_module_boundary_rule", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-ui-and-folder-restructure-design.md", "source_location": "\u00a72.3", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_ui_and_folder_restructure_design_spec", "target": "docs_superpowers_specs_2026_06_20_ui_and_folder_restructure_design_anti_ai_slop_principia", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-ui-and-folder-restructure-design.md", "source_location": "\u00a73", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_ui_and_folder_restructure_design_anti_ai_slop_principia", "target": "docs_superpowers_specs_2026_06_20_ui_and_folder_restructure_design_clinical_color_palette", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-ui-and-folder-restructure-design.md", "source_location": "\u00a73.2, \u00a73.3", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_ui_and_folder_restructure_design_dark_mode_class_strategy", "target": "docs_superpowers_specs_2026_06_20_ui_and_folder_restructure_design_clinical_color_palette", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-20-ui-and-folder-restructure-design.md", "source_location": "\u00a73.3, \u00a73.5", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_20_ui_and_folder_restructure_design_dark_mode_class_strategy", "target": "docs_superpowers_specs_202